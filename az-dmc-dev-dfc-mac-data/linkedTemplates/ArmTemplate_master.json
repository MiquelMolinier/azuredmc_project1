					},
					"ls_asql_retail_advWorks_properties_typeProperties_database": {
						"value": "[parameters('ls_asql_retail_advWorks_properties_typeProperties_database')]"
					},
					"ls_asql_retail_advWorks_properties_typeProperties_userName": {
						"value": "[parameters('ls_asql_retail_advWorks_properties_typeProperties_userName')]"
					},
					"ls_pg_retail_erp_df_properties_typeProperties_server": {
						"value": "[parameters('ls_pg_retail_erp_df_properties_typeProperties_server')]"
					},
					"ls_pg_retail_erp_df_properties_typeProperties_database": {
						"value": "[parameters('ls_pg_retail_erp_df_properties_typeProperties_database')]"
					},
					"ls_pg_retail_erp_df_properties_typeProperties_username": {
						"value": "[parameters('ls_pg_retail_erp_df_properties_typeProperties_username')]"
