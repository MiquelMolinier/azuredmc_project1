{
	"name": "df_ingesta_incremental_erp_venta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_asql_retail_ventas",
						"type": "DatasetReference"
					},
					"name": "OrigenErpVenta"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_adls_raw_parquet_particionado",
						"type": "DatasetReference"
					},
					"name": "DestinoRawVentaParquet"
				}
			],
			"transformations": [
				{
					"name": "AgregarAuditorialIngesta"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SalesOrderID as integer,",
				"          RevisionNumber as integer,",
				"          OrderDate as timestamp,",
				"          DueDate as timestamp,",
				"          ShipDate as timestamp,",
				"          Status as integer,",
				"          OnlineOrderFlag as boolean,",
				"          SalesOrderNumber as string,",
				"          PurchaseOrderNumber as string,",
				"          AccountNumber as string,",
				"          CustomerID as integer,",
				"          ShipToAddressID as integer,",
				"          BillToAddressID as integer,",
				"          ShipMethod as string,",
				"          CreditCardApprovalCode as string,",
				"          SubTotal as decimal(19,4),",
				"          TaxAmt as decimal(19,4),",
				"          Freight as decimal(19,4),",
				"          TotalDue as decimal(19,4),",
				"          Comment as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     enableCdc: true,",
				"     mode: 'read',",
				"     skipInitialLoad: false,",
				"     waterMarkColumn: 'ModifiedDate',",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> OrigenErpVenta",
				"OrigenErpVenta derive(fecha_ingesta_utc = currentTimestamp(),",
				"          origenSistema = 'AdvWorks:SalesLT.SalesOrderHeader') ~> AgregarAuditorialIngesta",
				"AgregarAuditorialIngesta sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'parquet',",
				"     umask: 0755,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> DestinoRawVentaParquet"
			]
		}
	}
}